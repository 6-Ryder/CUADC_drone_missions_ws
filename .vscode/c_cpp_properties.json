{
  "configurations": [
    {
      "browse": {
        "databaseFilename": "${workspaceFolder}/.vscode/browse.vc.db",
        "limitSymbolsToIncludedHeaders": false
      },
      "includePath": [
        "/opt/ros/humble/include/**",
        "/usr/include/**",
        "${workspaceFolder}/install/drone_interfaces/include/**",
        "${workspaceFolder}/install/px4_msgs/include/**",
        "${workspaceFolder}/install/drone_servo2/include/**",
        "${workspaceFolder}/src/drone_servo2/include/**"
      ],
      "compileCommands": "${workspaceFolder}/build/drone_servo2/compile_commands.json",
      "name": "ros2",
      "intelliSenseMode": "gcc-x64",
      "compilerPath": "/usr/bin/gcc",
      "cStandard": "gnu11",
      "cppStandard": "c++17"
    }
  ],
  "version": 4
}