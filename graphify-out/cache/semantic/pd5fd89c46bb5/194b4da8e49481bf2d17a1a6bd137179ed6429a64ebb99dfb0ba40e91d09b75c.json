{"nodes": [{"id": "src_drone_mission_config_mission_params", "label": "Mission Params (SITL Baseline)", "file_type": "code", "source_file": "src/drone_mission/config/mission_params.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_drone_mission_config_mission_params_ned_frame", "label": "PX4 NED Coordinate Frame", "file_type": "concept", "source_file": "src/drone_mission/config/mission_params.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u5168\u7cfb\u7edf\u7edf\u4e00\u5750\u6807\u7cfb: x=\u524d/North, y=\u53f3/East, z=\u4e0b (\u8d1f\u503c=\u5411\u4e0a); \u539f\u70b9 H=\u8d77\u98de\u70b9 (world 4,10,0, \u771f\u673a=0,0,0); \u98de\u884c\u65b9\u5411\u5317 (NED north \u6b63\u65b9\u5411); \u6295\u653e\u533a Home \u5317 32.5m, \u4fa6\u5bdf\u533a 57.5m"}, {"id": "src_drone_mission_config_mission_params_precision_align", "label": "CUADC-Style Precision Align Pixel Closed-Loop (\u4f4e\u7a7a\u89c6\u89c9\u7cbe\u6821)", "file_type": "rationale", "source_file": "src/drone_mission/config/mission_params.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CUADC \u98ce\u683c\u50cf\u7d20\u95ed\u73af\u53d6\u4ee3\u68af\u5ea6\u4e0b\u964d\u63a2\u6d4b (\u9ed8\u8ba4\u66ff\u4ee3 DropVisualAligner): EMA \u5e73\u6ed1 alpha 0.55 \u517c\u987e\u68c0\u6d4b\u6296\u52a8\u4e0e\u95ed\u73af\u54cd\u5e94; \u5f52\u4e00\u5316\u50cf\u7d20\u8bef\u5dee\u2192\u673a\u4f53\u7cfb\u901f\u5ea6\u6bd4\u4f8b (gain 1.25), \u7cbe\u8c03\u4e0a\u9650 0.065m/s \u77ed\u8109\u51b2\u9632\u8d8a\u8fc7\u4e2d\u5fc3; \u4e24\u7ea7\u964d\u9ad8: 2.8m \u6355\u83b7\u91cd\u7cbe\u6821 \u2192 1.5m \u6700\u7ec8\u6295\u653e, \u964d\u4f4e\u843d\u4f53\u6f02\u79fb\u548c\u50cf\u7d20\u5398\u7c73\u6362\u7b97; \u8df3\u53d8\u62d2\u7edd\u9608\u503c 0.55 \u5bf9\u89d2\u7ebf + \u4e22\u5931 48 \u5e27\u653e\u5f03\u76ee\u6807; \u771f\u673a\u53c2\u6570\u7ecf\u73b0\u573a 9 \u6b21\u5bf9\u5fc3\u6210\u529f\u9a8c\u8bc1; quick \u4e0b\u653e\u5bbd\u9608\u503c\u5e76\u53d6\u6d88\u4e24\u7ea7\u7a97\u53e3"}, {"id": "src_drone_mission_config_mission_params_gradient_probe", "label": "Gradient-Descent Probe Visual Calibration (\u68af\u5ea6\u4e0b\u964d\u63a2\u6d4b)", "file_type": "rationale", "source_file": "src/drone_mission/config/mission_params.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u4f4e\u7a7a\u89c6\u89c9\u6821\u51c6\u68af\u5ea6\u4e0b\u964d\u63a2\u6d4b: \u5355\u6b21\u63a2\u6d4b\u6b65\u957f 0.40m (\u4fe1\u53f7\u5927\u4e8e\u566a\u58f0 ~30px), \u63a2\u6d4b\u540e\u7a33\u5b9a 1.0s, \u8fde\u7eed\u5c45\u4e2d 6 \u5e27\u624d\u5141\u8bb8\u6295\u653e; \u88ab precision_align \u9ed8\u8ba4\u66ff\u4ee3, quick \u4e0b\u4e0d\u4f7f\u7528"}, {"id": "src_drone_mission_config_mission_params_boustrophedon_sweep", "label": "Boustrophedon Sweep Coverage (\u5f13\u5b57\u5f62\u8986\u76d6)", "file_type": "concept", "source_file": "src/drone_mission/config/mission_params.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u5f13\u5b57\u5f62\u8986\u76d6: grid_spacing 1.67m \u5bf9\u9f50 PathPlanner \u9ed8\u8ba4\u503c, \u957f\u8fb9\u754c (north) \u5185\u7f29 1.0m, \u6bb5\u8fb9\u754c (east) \u5185\u7f29 0.5m; \u4fa6\u5bdf\u533a\u5fc5\u987b\u8d70\u5b8c\u6574\u8def\u5f84, \u8986\u76d6\u7387\u4ec5\u4f5c\u76d1\u63a7"}, {"id": "src_drone_mission_config_mission_params_landing_servo", "label": "Landing Servo Image-Space P Controller (\u964d\u843d\u4f3a\u670d)", "file_type": "rationale", "source_file": "src/drone_mission/config/mission_params.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u56fe\u50cf\u7a7a\u95f4 P \u63a7\u5236\u5668 (\u4e0e\u6295\u653e\u533a\u7cbe\u6821\u540c\u65b9\u6cd5): kp 0.004 m/s per px, \u50cf\u7d20\u6b7b\u533a 12px \u5185\u505c\u6b62\u6c34\u5e73\u4fee\u6b63, \u6700\u5927\u6c34\u5e73\u901f\u5ea6 0.6 m/s; \u7b26\u53f7\u6807\u5b9a u\u8f74\u2192\u53f3\u79fb +1, v\u8f74\u2192\u524d\u98de -1 (\u4e0b\u89c6\u76f8\u673a y \u8f74\u5411\u540e); quick \u6a21\u5f0f\u8fb9\u4f3a\u670d\u8fb9\u4e0b\u964d (drop_servo_descend_*) \u590d\u7528\u6b64\u53c2\u6570"}, {"id": "src_drone_mission_config_mission_params_blind_landing", "label": "Blind Landing (\u76f2\u964d)", "file_type": "rationale", "source_file": "src/drone_mission/config/mission_params.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u5bf9\u5fc3\u7a33\u5b9a\u540e\u5207\u5165\u76f2\u964d: \u4f4e\u7a7a\u89c6\u89c9 H \u6807\u8bc6 ~0.9m \u5931\u6548 (SITL \u5b9e\u6d4b), \u771f\u673a 1.5m/SITL 1.0m \u5207\u76f2\u964d; PX4 \u63a5\u5730\u68c0\u6d4b\u8981\u6c42\u4e0b\u964d\u610f\u56fe >= 1.1*LNDMC_Z_VEL_MAX (0.275m/s), \u6545\u76f2\u964d\u4e0b\u964d\u901f\u5ea6\u53d6 0.30m/s; \u771f\u673a\u53ea\u63a5\u53d7 PX4 land_detected, SITL \u624d\u6709\u672c\u5730\u9ad8\u5ea6/\u901f\u5ea6\u5907\u7528\u63a5\u5730\u786e\u8ba4"}], "edges": [{"source": "src_drone_mission_config_mission_params", "target": "src_drone_mission_config_mission_params_real", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "src/drone_mission/config/mission_params.yaml", "source_location": null, "weight": 1.0}, {"source": "src_drone_mission_config_mission_params", "target": "src_drone_servo2_config_servo_params", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/drone_mission/config/mission_params.yaml", "source_location": null, "weight": 1.0}, {"source": "src_drone_mission_config_mission_params", "target": "src_drone_mission_config_mission_params_precision_align", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/drone_mission/config/m