{"nodes": [{"id": "docs_tactics_plan_quick_heading_stable_takeoff_yaw_safety_plan", "label": "Takeoff Yaw Safety Strategy Plan", "file_type": "document", "source_file": "docs/Tactics/PLAN_quick_heading_stable.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_tactics_plan_quick_heading_stable_hold_actual_yaw_takeoff", "label": "Hold Actual Yaw During Takeoff, Turn After 5 m", "file_type": "rationale", "source_file": "docs/Tactics/PLAN_quick_heading_stable.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "px4_bridge dyaw*0.3 is a discrete low-pass, not a physical yaw-rate limit: at 20 Hz a 0\u00b0\u219230\u00b0 target can jump ~9\u00b0 in the first cycle, causing roll, power redistribution and altitude fluctuation on a real aircraft. So pre-arm, arm, Offboard switch and climb keep the actual current yaw; only after the 5 m TAKEOFF check passes does the mission yaw switch to layout_heading_deg."}, {"id": "docs_tactics_plan_quick_heading_stable_yaw_slew_rate", "label": "Parameterized Yaw Slew Rate Limit (15\u201320\u00b0/s)", "file_type": "concept", "source_file": "docs/Tactics/PLAN_quick_heading_stable.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_tactics_plan_quick_heading_stable_takeoff_yaw_safety_plan", "target": "docs_tactics_plan_quick_heading_stable_hold_actual_yaw_takeoff", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/Tactics/PLAN_quick_heading_stable.md", "source_location": null, "weight": 1.0}, {"source": "docs_tactics_plan_quick_heading_stable_takeoff_yaw_safety_plan", "target": "docs_tactics_plan_quick_heading_stable_yaw_slew_rate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/Tactics/PLAN_quick_heading_stable.md", "sourc