{"nodes": [{"id": "src_drone_mission_config_mission_params_quick", "label": "Mission Params Quick (Real Hardware)", "file_type": "code", "source_file": "src/drone_mission/config/mission_params_quick.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_drone_mission_config_mission_params_landing_simple_mode", "label": "Landing Simple Mode (test_mission \u65b9\u6cd5)", "file_type": "rationale", "source_file": "src/drone_mission/config/mission_params_quick.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "simple \u6a21\u5f0f: \u65e0\u5bf9\u5fc3\u9501\u5b58/\u5907\u7528\u63a5\u5730\u786e\u8ba4, \u63a5\u5730\u53ea\u8ba4 PX4 is_landed; \u4e22\u5931/\u8d85\u65f6 \u2192 PX4 \u81ea\u4e3b\u7740\u9646; \u76f2\u964d\u6bb5\u89c6\u89c9\u5df2\u5173, 3s \u4e22\u5931\u8d85\u65f6\u5148\u89e6\u53d1 \u2192 PX4 LAND \u63a5\u7ba1 (landing_simple_blind_timeout \u5b9e\u9645\u4e0d\u53ef\u8fbe); \u4f3a\u670d\u964d\u5230 0.5m (\u771f\u673a)/1.0m (SITL) \u624d\u5207\u76f2\u964d; \u4e0b\u964d\u901f\u5ea6 0.15m/s \u66f4\u6162\u4f46\u7b49 PX4 \u7740\u9646\u68c0\u6d4b\u66f4\u7a33"}, {"id": "src_drone_mission_config_mission_params_quick_quick_drop_strategy", "label": "Quick Drop Strategy (\u5feb\u901f\u6295\u653e\u7b56\u7565)", "file_type": "rationale", "source_file": "src/drone_mission/config/mission_params_quick.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u5feb\u901f\u6295\u653e\u7b56\u7565: \u5355\u6b21\u964d\u9ad8 2.4m \u53d6\u6d88\u4e24\u7ea7\u964d\u9ad8 (\u539f 2.8+1.5), marker_only \u89c6\u89c9 (\u84dd\u5e95\u76f4\u63a5\u4e3b\u76ee\u6807, \u96f6\u5ef6\u8fdf, 1 \u6b21\u89c2\u6d4b\u5373\u5165\u5e93), \u653e\u5bbd\u5bf9\u5fc3\u9608\u503c, \u5355\u6b21\u53cc\u6295 (\u4e00\u6b21\u5f00\u8235\u673a 1150\u21922150); \u4e2d\u8f6c/\u8fd4\u822a\u63d0\u901f; \u8fb9\u4f3a\u670d\u8fb9\u4e0b\u964d\u590d\u7528\u964d\u843d\u533a\u4f3a\u670d\u53c2\u6570; \u76ee\u6807\u4e3a\u7aef\u5230\u7aef\u4efb\u52a1\u65f6\u95f4\u4f18\u5316"}, {"id": "src_drone_mission_config_mission_params_quick_progress_guard", "label": "No-Progress Guard (\u65e0\u8fdb\u5c55\u5b88\u536b)", "file_type": "rationale", "source_file": "src/drone_mission/config/mission_params_quick.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u4ec5\u65e0\u8fdb\u5c55\u65f6\u540c\u76ee\u6807\u91cd\u53d1/\u91cd\u8d70\u641c\u7d22\u8def\u5f84: \u5bfc\u822a\u7a97\u53e3 30s \u6700\u4f4e\u6539\u8fdb 0.25m, \u641c\u7d22\u7a97\u53e3 30s, \u50cf\u7d20\u7cbe\u6821\u7a97\u53e3\u6700\u4f4e\u8bef\u5dee\u6539\u8fdb 2px; \u4ee3\u66ff\u56fa\u5b9a\u603b\u65f6\u957f\u4e2d\u6b62 \u2014 \u771f\u673a state_max_duration=0 \u53ea\u76d1\u6d4b\u65e0\u8fdb\u5c55"}], "edges": [{"source": "src_drone_mission_config_mission_params_quick", "target": "src_drone_mission_config_mission_params_real", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/drone_mission/config/mission_params_quick.yaml", "source_location": null, "weight": 1.0}, {"source": "src_drone_mission_config_mission_params_quick", "target": "src_drone_servo2_config_servo_params_quick", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/drone_mission/config/mission_params_quick.yaml", "source_location": null, "weight": 1.0}, {"source": "src_drone_mission_config_mission_params_quick", "target": "src_drone_mission_config_mission_params_quick_quick_drop_strategy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/drone_mission/config/mission_params_quick.yaml", "source_location": null, "weight": 1.0}, {"source": "src_drone_mission_config_mission_params_quick_quick_drop_strategy", "target": "src_drone_mission_config_mission_params_landing_servo", "relation":