{"nodes": [{"id": "docs_deployment_full_real_mission_guide", "label": "\u5168\u6d41\u7a0b\u771f\u673a\u98de\u884c\u6307\u5357 (Full Real Mission Guide)", "file_type": "document", "source_file": "docs/Deployment/FULL_REAL_MISSION_GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u5bf9\u5e94\u5f53\u524d\u552f\u4e00\u7684\u5168\u6d41\u7a0b\u771f\u673a\u5165\u53e3\uff0c\u63cf\u8ff0\u771f\u5b9e PX4 v1\u3001\u76f8\u673a\u3001\u89c6\u89c9\u3001\u8235\u673a\u548c MissionFSM \u7684\u8054\u8c03\u65b9\u5f0f\uff1b\u6587\u6863\u4e0d\u66ff\u4ee3\u73b0\u573a\u98de\u624b\u7684\u5b89\u5168\u5224\u65ad\uff0c\u4ee3\u7801\u6ca1\u6709\u81ea\u52a8\u89e3\u9501"}, {"id": "docs_deployment_full_real_mission_guide_missionfsm", "label": "MissionFSM \u72b6\u6001\u5e8f (INIT\u2192\u2026\u2192COMPLETE)", "file_type": "concept", "source_file": "docs/Deployment/FULL_REAL_MISSION_GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u72b6\u6001\u987a\u5e8f INIT\u2192ARM\u2192TAKEOFF\u2192TRANSIT_TO_DROP_ZONE\u2192CYLINDER_SEARCH\u2192SELECT_TARGET\u2192CYLINDER_APPROACH\u2192DESCEND_TO_DROP\u2192EXECUTE_DROP\u2192ASCEND\u2192TRANSIT_TO_RECON_ZONE\u2192RECON_PATROL\u2192RETURN_TO_HOME\u2192PRECISION_LAND\u2192COMPLETE\uff1b\u4fa6\u5bdf\u533a\u626b\u63cf\u5b8c\u4ece\u6700\u540e\u822a\u70b9\u76f4\u63a5\u8fd4\u822a\u3001\u8fb9\u79fb\u52a8\u8fb9\u56de\u5347\u81f3 5m \u4e0d\u5355\u72ec\u63d2\u5165\u722c\u5347\uff1b\u63a5\u5730\u540e\u7b49 PX4 \u62a5\u544a armed=false \u624d\u91ca\u653e\u81ea\u4e3b\u63a7\u5236\u79df\u7ea6"}, {"id": "docs_deployment_full_real_mission_guide_start_full_real_mission", "label": "start_full_real_mission.sh \u5168\u6d41\u7a0b\u5165\u53e3", "file_type": "concept", "source_file": "docs/Deployment/FULL_REAL_MISSION_GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u811a\u672c\u4f1a\u521b\u5efa log/real_mission_YYYYMMDD_HHMMSS/\uff0c\u5148\u6e05\u7406\u65e7\u8fdb\u7a0b\u5e76\u542f\u52a8\u552f\u4e00 MicroXRCEAgent (UDP 8888)\uff0c\u7b49\u5f85 PX4 DDS \u5c31\u7eea\u540e\u518d\u7531 launch \u542f\u52a8\u4efb\u52a1\u8282\u70b9\uff1b\u4e0d\u4f1a\u81ea\u52a8 Arm\u3001\u5207\u6362\u98de\u884c\u6a21\u5f0f\u3001\u8c03\u7528\u6295\u653e\u670d\u52a1\u6216\u6267\u884c\u964d\u843d\uff1b\u652f\u6301 systemd/cron @reboot \u81ea\u542f\u4e0e --agent-only \u6a21\u5f0f"}, {"id": "docs_deployment_full_real_mission_guide_verify_ready", "label": "verify_real_flight_ready.sh \u5c31\u7eea\u68c0\u67e5", "file_type": "concept", "source_file": "docs/Deployment/FULL_REAL_MISSION_GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u5fc5\u987b\u8f93\u51fa READY \u6700\u540e\u4e00\u884c\uff1b\u68c0\u67e5 PX4 \u72b6\u6001/\u91cc\u7a0b\u8ba1/\u7535\u6c60/\u63a5\u5730\u68c0\u6d4b\u65b0\u6837\u672c\u3001vehicle_command_ack \u53d1\u5e03\u8005\u3001CameraInfo 640\u00d7480\u3001/drone/vision/status ready=1\u3001/drone/servo/status ready=1\uff1b\u68c0\u67e5\u811a\u672c\u4e0d\u4f1a\u8c03\u7528\u6295\u653e\u670d\u52a1\uff1b\u4ee3\u7801\u5148\u6301\u7eed\u53d1\u9001\u5b89\u5168\u4fdd\u6301\u8bbe\u5b9a\u70b9\u81f3\u5c11 1 \u79d2\u518d\u8bf7\u6c42 Offboard"}, {"id": "docs_deployment_full_real_mission_guide_precision_land", "label": "H \u6807\u8bc6\u7cbe\u51c6\u5782\u76f4\u76f2\u964d (Precision Landing)", "file_type": "concept", "source_file": "docs/Deployment/FULL_REAL_MISSION_GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u7cbe\u51c6\u964d\u843d\u5148\u7b49\u5f85 H \u6807\u8bc6\u548c\u89c6\u89c9\u5bf9\u5fc3\u7a33\u5b9a\u518d\u6267\u884c\u5782\u76f4\u76f2\u964d\uff1b\u89c6\u89c9\u53ea\u5728\u9700\u8981\u7684\u72b6\u6001\u53c2\u4e0e\u51b3\u7b56\uff08\u5706\u7b52\u2192\u6295\u653e\u5b9a\u4f4d\u3001\u8986\u76d6\u76d1\u63a7\u2192\u4fa6\u5bdf\u5b8c\u6210\u5224\u5b9a\u3001H \u6807\u8bc6\u548c\u5bf9\u5fc3\u2192\u7cbe\u51c6\u964d\u843d\uff09\uff1b\u964d\u843d\u9636\u6bb5\u4e0d\u5f97\u628a\u6682\u65f6\u4e22\u5931\u7684\u5355\u5e27\u89c6\u89c9\u7ed3\u679c\u5f53\u6210\u5df2\u63a5\u5730\uff1b\u6700\u7ec8\u5b8c\u6210\u6761\u4ef6\u4e3a PX4 vehicle_land_detected \u63a5\u5730\u5e76\u786e\u8ba4 armed=false"}, {"id": "docs_deployment_full_real_mission_guide_failure_recovery", "label": "\u6709\u9650\u91cd\u8bd5\u4e0e\u96f6\u901f\u60ac\u505c B \u65b9\u6848 (Finite Retry + Zero-velocity Hover)", "file_type": "rationale", "source_file": "docs/Deployment/FULL_REAL_MISSION_GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u4efb\u52a1\u91c7\u7528\u6709\u9650\u91cd\u8bd5\u7b56\u7565\uff1a\u540c\u4e00\u52a8\u4f5c\u4f18\u5148\u91cd\u8bd5\u4e00\u6b21\uff0c\u4ecd\u65e0\u6cd5\u5b8c\u6210\u8fdb\u5165 B \u65b9\u6848\uff0c\u5373\u4fdd\u6301\u96f6\u901f\u5ea6 Offboard \u60ac\u505c\u7b49\u5f85\u64cd\u4f5c\u8005\u63a5\u7ba1\uff1b\u4efb\u52a1\u7ea7\u6545\u969c\u4e0d\u4f1a\u81ea\u52a8\u8c03\u7528 RTL \u6216 LAND\uff0c\u4fdd\u7559\u73b0\u573a\u4eba\u5458\u5bf9\u4f4d\u7f6e/\u969c\u788d\u7269/\u98ce\u51b5\u7684\u5224\u65ad\uff0c\u907f\u514d\u5728\u89c6\u89c9\u4efb\u52a1\u4e2d\u5f3a\u884c\u5207\u6362\u5230\u4e0d\u7b26\u5408\u73b0\u573a\u7684\u81ea\u52a8\u6a21\u5f0f\uff1b\u672a\u786e\u8ba4\u89e3\u9501\u524d MissionFSM \u4fdd\u6301\u96f6\u901f\u5ea6\u8bbe\u5b9a\u70b9\uff0c\u4e0d\u91ca\u653e\u63a7\u5236\u79df\u7ea6\u540e\u76f2\u76ee\u4e0b\u964d"}, {"id": "docs_deployment_full_real_mission_guide_safety_takeover", "label": "\u9065\u63a7\u5668\u4eba\u5de5\u63a5\u7ba1\u539f\u5219 (RC Manual Takeover)", "file_type": "rationale", "source_file": "docs/Deployment/FULL_REAL_MISSION_GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u53d1\u73b0\u98de\u673a\u59ff\u6