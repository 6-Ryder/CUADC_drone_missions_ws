{"nodes": [{"id": "src_drone_vision_config_vision_params", "label": "Vision Params (YOLO + OpenCV Hybrid)", "file_type": "code", "source_file": "src/drone_vision/config/vision_params.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_drone_vision_config_vision_params_hybrid_pipeline", "label": "YOLO + OpenCV Hybrid Detection Pipeline", "file_type": "rationale", "source_file": "src/drone_vision/config/vision_params.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "YOLO \u68c0\u6d4b + OpenCV \u7cbe\u4fee\u6df7\u5408: \u5706\u7b52\u692d\u5706\u62df\u5408 (Canny 30/120, \u591a\u5e27\u8ffd\u8e2a min_hits 3 \u8fc7\u6ee4\u95ea\u70c1\u5047\u76ee\u6807); \u84dd\u6807 YOLO bbox \u5185 HSV \u84dd\u8272\u5206\u5272\u53d6\u8f6e\u5ed3\u8d28\u5fc3 (min_blue_ratio 0.4, \u5706\u5f62\u5ea6 0.35 \u8fc7\u6ee4\u7ebf\u7f06); H \u6807\u8bc6\u81ea\u9002\u5e94\u9608\u503c (\u5757 11); \u5355\u7c7b\u6a21\u578b cylinder/drop_zone_marker/landing_H \u6309\u9700\u52a0\u8f7d; \u771f\u673a\u76f8\u673a\u6807\u5b9a fx/fy 400 (640x480), SITL fx 539.9 (1280x960)"}, {"id": "src_drone_vision_config_vision_params_drop_zone_marker", "label": "Blue Drop Zone Marker (\u84dd\u5e95\u6295\u653e\u6807\u8bc6)", "file_type": "concept", "source_file": "src/drone_vision/config/vision_params.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u84dd\u8272\u6295\u653e\u6807\u8bc6: \u72ec\u7acb\u5355\u7c7b YOLO \u6a21\u578b + HSV \u7cbe\u4fee; baseline \u4e2d\u4f5c\u4e3a\u5706\u7b52\u68c0\u6d4b\u4e0d\u7a33\u65f6\u7684\u515c\u5e95 (fallback_delay 15s, min_confidence 0.35, \u9700 3 \u6b21\u89c2\u6d4b\u5165\u5e93), quick \u4e2d\u76f4\u63a5\u4f5c\u4e3a\u4e3b\u6295\u653e\u76ee\u6807 (\u96f6\u5ef6\u8fdf, 1 \u6b21\u89c2\u6d4b\u5165\u5e93)"}, {"id": "src_drone_vision_config_vision_params_coverage_zone", "label": "Coverage Monitoring Zone (\u4fa6\u5bdf\u533a\u8986\u76d6\u76d1\u63a7)", "file_type": "concept", "source_file": "src/drone_vision/config/vision_params.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u5317\u5411\u573a\u5730\u4fa6\u5bdf\u533a\u8986\u76d6\u76d1\u63a7: World X[0,8] (East\u00b14), Y[65,70] (North 55-60), \u7f51\u683c 0.5m, FOV \u534a\u89d2 35\u00b0, \u5168\u8986\u76d6\u5224\u5b9a\u9608\u503c 0.95; \u5750\u6807\u7531 Home (4,10,0) \u4e0e NED \u4fa6\u5bdf\u533a\u8fb9\u754c\u63a8\u5bfc"}], "edges": [{"source": "src_drone_vision_config_vision_params", "target": "src_drone_vision_config_vision_params_drop_zone_marker", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/drone_vision/config/vision_params.yaml", "source_location": null, "weight": 1.0}, {"source": "src_drone_vision_config_vision_params", "target": "src_drone_vision_config_vision_params_coverage_zone", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/drone_vision/config/vision_params.yaml", "source_location": null, "weight": 1.0}], "hyperedges": []}